# Application
# APP_MODE must be "production" for npm start. Demo auth is for tests only.
APP_MODE=production
PORT=3000
ENABLE_VOICE=false
ENABLE_TWILIO=false

# Local dev trace logs (stdout JSON): http_request, tool_dispatch, agent_turn
# LOG_TRACE=true

# PostgreSQL — clinic source of truth
DATABASE_URL=postgresql://clinic:clinic@localhost:54329/clinic_voice_ai

# Google Calendar — real calendar in production; tests often use a fake
GOOGLE_CALENDAR_SERVICE_ACCOUNT_EMAIL=
GOOGLE_CALENDAR_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=Africa/Cairo

# Redis — short chat memory only (not patient identity)
# Production requires an explicit REDIS_URL.
REDIS_URL=redis://127.0.0.1:63799
WORKING_MEMORY_TTL_SECONDS=3600
WORKING_MEMORY_KEY_PREFIX=clinic:wm
WORKING_MEMORY_MAX_TURNS=100

# OpenRouter — chat model
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=30000
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=clinic-voice-ai
# Live LLM eval only: npm run eval:live

# Embeddings — required for production start (never use deterministic mode in production)
# Prefer EMBEDDING_API_KEY; falls back to OPENROUTER_API_KEY.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_TIMEOUT_MS=30000
# Opt-in live embedding tests: LIVE_EMBEDDINGS=1 npm run test:embeddings

# Qdrant — search helper (rebuild with npm run rebuild:search)
QDRANT_URL=http://127.0.0.1:63339
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=clinic_
QDRANT_TIMEOUT_MS=15000

# Neo4j — relationship helper (rebuild with npm run rebuild:graph)
NEO4J_URI=bolt://127.0.0.1:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=clinic-voice-ai
NEO4J_DATABASE=neo4j

# Auth — OIDC JWT + JWKS (IdP-agnostic). Never use demo auth in production.
AUTH_ISSUER=https://auth.example.com/
AUTH_AUDIENCE=clinic-voice-ai
AUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json

# Opik — optional AI tracing (fail-open if unset/down)
OPIK_API_KEY=
OPIK_URL_OVERRIDE=https://www.comet.com/opik/api
OPIK_PROJECT_NAME=clinic-voice-ai
OPIK_WORKSPACE=

# Gemini Live voice — optional
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Twilio PSTN — transport only; Caller ID is NOT patient login
# ENABLE_TWILIO=true requires the three values below.
TWILIO_AUTH_TOKEN=
TWILIO_VOICE_WEBHOOK_URL=https://example.com/v1/twilio/voice
TWILIO_MEDIA_STREAM_WS_URL=wss://example.com/v1/twilio/media
