{
  "name": "clinic-voice-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Clinic appointment voice/chat AI — domain-first architecture",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/server.ts",
    "services:up": "docker compose up -d postgres redis",
    "services:up:all": "docker compose up -d postgres redis qdrant neo4j",
    "services:down": "docker compose down",
    "rebuild:search": "tsx src/bin/rebuild-derived-stores.ts search",
    "rebuild:graph": "tsx src/bin/rebuild-derived-stores.ts graph",
    "rebuild:derived": "tsx src/bin/rebuild-derived-stores.ts all",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/bin/seed-clinic-data.ts",
    "db:seed:full": "tsx src/bin/seed-clinic-data.ts && tsx src/bin/rebuild-derived-stores.ts search",
    "db:up": "docker compose up -d postgres",
    "db:setup": "npm run db:up && npm run db:migrate",
    "db:reset:local": "bash scripts/db-reset-local.sh",
    "redis:up": "docker compose up -d redis",
    "qdrant:up": "docker compose up -d qdrant",
    "neo4j:up": "docker compose up -d neo4j",
    "db:down": "docker compose down",
    "test": "vitest run tests/domain tests/application tests/architecture tests/calendar tests/memory tests/agent tests/interfaces tests/llm tests/vector tests/graph tests/auth tests/observability tests/voice tests/telephony tests/evaluation/agent-golden.test.ts",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:embeddings": "vitest run tests/integration/embeddings --config vitest.integration.config.ts",
    "test:all": "npm test && npm run test:integration",
    "eval:live": "vitest run --config vitest.live-eval.config.ts",
    "check:deps": "depcruise src --config .dependency-cruiser.cjs",
    "production:check": "bash scripts/production-check.sh",
    "production:smoke": "bash scripts/production-smoke.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dependency-cruiser": "^16.10.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@qdrant/js-client-rest": "^1.15.1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "googleapis": "^176.0.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.10",
    "neo4j-driver": "^5.28.3",
    "opik": "^1.11.14",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  }
}
